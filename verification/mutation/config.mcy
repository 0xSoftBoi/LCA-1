[options]
size 200
tags COVERED UNCOVERED

[script]
read_verilog -sv ../../rtl/lca_modmul.sv ../../rtl/lca_butterfly.sv
synth -top lca_butterfly -flatten

[files]
../../rtl/lca_modmul.sv
../../rtl/lca_butterfly.sv

[logic]
if result("test_sim") == "FAIL":
    tag("COVERED")
else:
    tag("UNCOVERED")

[report]
if tags("COVERED")+tags("UNCOVERED"):
    print("Corpus mutation coverage: %.2f%% (%d/%d killed)" % (
        100.0*tags("COVERED")/(tags("COVERED")+tags("UNCOVERED")),
        tags("COVERED"), tags("COVERED")+tags("UNCOVERED")))

[test test_sim]
expect PASS FAIL
run bash $PRJDIR/test_sim.sh
