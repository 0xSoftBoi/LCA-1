# SPDX-License-Identifier: Apache-2.0
read_verilog -formal -sv rtl/lca_modmul.sv formal/lca_modmul_arithmetic_formal.sv
prep -top lca_modmul_arithmetic_formal
flatten
formalff -clk2ff
chformal -lower
sat -verify -prove-asserts -set-assumes -set-def-formal -set-def-inputs -seq 9 -set-init-zero

design -reset
read_verilog -formal -sv rtl/lca_modmul.sv formal/lca_modmul_protocol_formal.sv
prep -top lca_modmul_protocol_formal
flatten
formalff -clk2ff
chformal -lower
sat -verify -prove-asserts -set-assumes -set-def-formal -set-def-inputs -seq 29 -set-init-zero

design -reset
read_verilog -formal -sv rtl/lca_modmul.sv rtl/lca_butterfly.sv formal/lca_butterfly_fault_formal.sv
prep -top lca_butterfly_fault_formal
flatten
formalff -clk2ff
chformal -lower
sat -verify -prove-asserts -set-assumes -set-def-formal -set-def-inputs -seq 5 -set-init-zero

# Unbounded temporal-induction proofs of the protocol invariants embedded in
# the RTL under `ifdef FORMAL: all inputs unconstrained on every cycle. The
# base case starts from the zero (reset) state; the invariant sets prove
# 1-inductive, so the properties hold at all times, not up to a bound.
design -reset
read_verilog -formal -sv rtl/lca_modmul.sv
prep -top lca_modmul
flatten
chformal -lower
sat -tempinduct -verify -prove-asserts -set-assumes -set-init-zero -maxsteps 30

design -reset
read_verilog -formal -sv rtl/lca_modmul.sv rtl/lca_butterfly.sv
prep -top lca_butterfly
flatten
chformal -lower
sat -tempinduct -verify -prove-asserts -set-assumes -set-init-zero -maxsteps 30
